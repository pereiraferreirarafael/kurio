# Ativa a camada MSW (REST + Socket.IO). Mantida ativa também no build de demonstração.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks. Pode ser sobrescrito por ?scenario=<nome> ou localStorage.
VITE_MOCK_SCENARIO=default
# Base da API REST. Com mocks ativos o MSW intercepta qualquer origem neste caminho.
VITE_API_BASE_URL=/api
